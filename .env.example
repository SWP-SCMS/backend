DB_URL=jdbc:postgresql://localhost:5432/scms
DB_USERNAME=replace-me
DB_PASSWORD=replace-me
PORT=8080
TRUST_RAILWAY_PROXY_HEADERS=false
PROFILE_IMAGES_DIRECTORY=./data/profile-images
PROFILE_IMAGES_MAX_BYTES=5242880
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ALLOWED_ORIGINS=http://localhost:5173
SEPAY_BANK_CODE=VCB
SEPAY_BANK_ACCOUNT=replace-me
SEPAY_BANK_ACCOUNT_NAME=replace-me
# SHA-256 of uppercase-trimmed bankCode|bankAccount|bankAccountName generated from the approved destination.
# Store this under separate deployment permissions from ordinary application configuration.
SEPAY_BANK_DESTINATION_SHA256=replace-with-approved-destination-sha256
SEPAY_WEBHOOK_API_KEY=replace-with-a-long-random-key
INITIAL_MANAGER_ENABLED=false
INITIAL_MANAGER_FULL_NAME=
INITIAL_MANAGER_PHONE=
INITIAL_MANAGER_EMAIL=
INITIAL_MANAGER_BIRTH_DATE=
INITIAL_MANAGER_PASSWORD=
# Email verification remains disabled until FE routes and staging SMTP are ready.
EMAIL_VERIFICATION_ENABLED=false
EMAIL_REGISTRATION_TTL=24h
EMAIL_OTP_TTL=10m
EMAIL_OTP_RESEND_COOLDOWN=60s
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_HMAC_ACTIVE_VERSION=v1
EMAIL_OTP_HMAC_KEYS=v1:<base64-32-byte-key>
EMAIL_OTP_ENCRYPTION_ACTIVE_VERSION=v1
EMAIL_OTP_ENCRYPTION_KEYS=v1:<base64-32-byte-key>
EMAIL_VERIFICATION_RATE_LIMIT_KEY=<base64-32-byte-key>
EMAIL_VERIFICATION_COOKIE_SECURE=true
EMAIL_VERIFICATION_COOKIE_SAME_SITE=Lax
SCMS_EMAIL_PROVIDER=smtp
EMAIL_SUPPORT_CONTACT=support@scms.vn
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ALLOW_CUSTOM_FROM=false
SMTP_RECIPIENT_OVERRIDE=
SMTP_AUTH=true
SMTP_TLS_ENABLED=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000
SERVER_FORWARD_HEADERS_STRATEGY=none
